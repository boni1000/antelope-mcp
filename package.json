{
  "name": "antelope-mcp",
  "version": "0.1.1",
  "description": "MCP server for any Antelope chain (Vaulta, Telos, WAX, private): read anything, write only within on-chain permissions",
  "type": "module",
  "license": "MIT",
  "bin": {
    "antelope-mcp": "dist/index.js"
  },
  "files": [
    "dist/*.js",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "antelope-mcp.env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@wharfkit/antelope": "4.0.2",
    "@wharfkit/signing-request": "4.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boni1000/antelope-mcp.git"
  },
  "homepage": "https://github.com/boni1000/antelope-mcp#readme",
  "bugs": {
    "url": "https://github.com/boni1000/antelope-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "antelope",
    "eosio",
    "vaulta",
    "eos",
    "telos",
    "wax",
    "blockchain",
    "ai-agents",
    "wharfkit",
    "esr",
    "anchor"
  ],
  "author": "boni1000"
}
