# Required: the chain API endpoint. Tools never take a URL, so an agent cannot point the server elsewhere.
ANTELOPE_URL=https://jungle4.greymass.com
# Optional: refuse to start if the endpoint serves another chain.
ANTELOPE_CHAIN_ID=73e4385a2708e6d7048834fbc1079f2fabb17b3c125b146af438971e90716c4d
ANTELOPE_CHAIN_NAME=Jungle4
# Optional: a Hyperion history endpoint, for the actions of past transactions.
#ANTELOPE_HYPERION_URL=https://jungle4.eosusa.io

# Optional signer. Without it the server is keyless: it reads, simulates, and prepares
# transactions (ESR links) for a wallet to sign.
#ANTELOPE_SIGNER=myagent@mcp                 # the only authority the server signs with
#ANTELOPE_PRIVATE_KEY_FILE=/etc/antelope-mcp/mcp.key   # bare key, or `cleos create key --file` output; chmod 600
# Which actions may be pushed is read from the chain: the actions linked (linkauth) to that
# permission. For an unlinked permission (active/owner) nothing is allowed unless listed here:
#ANTELOPE_ALLOWED_ACTIONS=eosio.token::transfer,mycontract::*

# Validity of unsigned transactions from prepare_transaction (seconds, default 300)
#ANTELOPE_TX_EXPIRE_SECONDS=300
# Validity of transactions the server signs itself (seconds, default 30)
#ANTELOPE_PUSH_EXPIRE_SECONDS=30
